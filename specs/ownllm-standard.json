{
  "version": 8,
  "name": "ownllm",
  "description": "Self-hosted CPU LLM endpoint (Ollama + Open WebUI) on Flux",
  "owner": "196GJWyLxzAw3MirTT7Bqs2iGpUQio29GH",
  "compose": [
    {
      "name": "engine",
      "description": "Ollama model server (internal only, no published port)",
      "repotag": "ollama/ollama:latest",
      "ports": [],
      "containerPorts": [],
      "domains": [],
      "environmentParameters": [
        "OLLAMA_HOST=0.0.0.0:11434",
        "OLLAMA_MODELS=/models",
        "OLLAMA_NUM_THREAD=8",
        "OMP_NUM_THREADS=8",
        "OLLAMA_CONTEXT_LENGTH=16384",
        "OLLAMA_MAX_LOADED_MODELS=2",
        "OLLAMA_NUM_PARALLEL=1",
        "OLLAMA_KEEP_ALIVE=30m",
        "OLLAMA_FLASH_ATTENTION=1",
        "OLLAMA_KV_CACHE_TYPE=q8_0"
      ],
      "commands": [
        "serve"
      ],
      "containerData": "/models",
      "repoauth": "",
      "cpu": 8,
      "ram": 26000,
      "hdd": 60
    },
    {
      "name": "boot",
      "description": "One-shot model puller, then idles",
      "repotag": "alpine:3.20",
      "ports": [],
      "containerPorts": [],
      "domains": [],
      "environmentParameters": [
        "MODELS=gpt-oss:20b qwen3:4b"
      ],
      "commands": [
        "/bin/sh",
        "-c",
        "apk add -q --no-cache curl; U=http://fluxengine_ownllm:11434; until curl -sf $U/api/tags >/dev/null 2>&1; do sleep 5; done; for m in $MODELS; do echo \"pulling $m\"; curl -s $U/api/pull -d '{\"model\":\"'$m'\"}' >/dev/null; echo \"done $m\"; done; while :; do sleep 3600; done"
      ],
      "containerData": "/tmp",
      "repoauth": "",
      "cpu": 0.1,
      "ram": 100,
      "hdd": 1
    },
    {
      "name": "webui",
      "description": "Open WebUI - browser UI plus authenticated OpenAI-compatible API",
      "repotag": "ghcr.io/open-webui/open-webui:main",
      "ports": [
        33000
      ],
      "containerPorts": [
        8080
      ],
      "domains": [
        ""
      ],
      "environmentParameters": [
        "OLLAMA_BASE_URL=http://fluxengine_ownllm:11434",
        "WEBUI_AUTH=true",
        "ENABLE_API_KEY=true",
        "ENABLE_SIGNUP=true",
        "ENABLE_OPENAI_API=false"
      ],
      "commands": [],
      "containerData": "/app/backend/data",
      "repoauth": "",
      "cpu": 1,
      "ram": 1500,
      "hdd": 5
    }
  ],
  "instances": 1,
  "contacts": [],
  "geolocation": [],
  "expire": 88000,
  "nodes": [],
  "staticip": false,
  "datacenter": false,
  "enterprise": false
}
