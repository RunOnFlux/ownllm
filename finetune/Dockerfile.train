# training image for finetune/train.py on a rented gpu (fluxedge, runpod, ...)
#
#   docker build -f finetune/Dockerfile.train -t flux-llm-train .
#   docker run --gpus all -v $PWD:/work -v hf-cache:/root/.cache/huggingface \
#       -e HF_TOKEN=... flux-llm-train \
#       --base ibm-granite/granite-4.0-h-tiny --data data/train.jsonl \
#       --eval data/eval.jsonl --out runs/tinyh-v1 --bf16 --grad-ckpt
#
# the repo is mounted at /work so data/ and runs/ live on the host. mount a
# named volume on /root/.cache/huggingface or the 14 GB base download repeats
# on every run.
#
# runtime image is enough for torch + bitsandbytes (prebuilt wheels). the fused
# mamba2 kernels (mamba-ssm, causal-conv1d) need nvcc: switch the base to the
# -devel tag and uncomment the block below if you want them (~3x faster).
FROM nvidia/cuda:12.4.1-runtime-ubuntu22.04

ENV DEBIAN_FRONTEND=noninteractive PIP_NO_CACHE_DIR=1 PYTHONUNBUFFERED=1 \
    HF_HOME=/root/.cache/huggingface TOKENIZERS_PARALLELISM=false

RUN apt-get update && apt-get install -y --no-install-recommends \
      python3 python3-pip python3-venv git git-lfs cmake build-essential ca-certificates \
    && rm -rf /var/lib/apt/lists/* && python3 -m pip install --upgrade pip

# torch first from the cu124 index so the cuda wheel matches the base image
RUN pip install torch==2.5.1 --index-url https://download.pytorch.org/whl/cu124

COPY finetune/requirements.txt /tmp/requirements.txt
RUN pip install -r /tmp/requirements.txt

# optional fused kernels (needs -devel base):
# RUN pip install causal-conv1d>=1.4 mamba-ssm>=2.2 --no-build-isolation

WORKDIR /work
ENTRYPOINT ["python3", "finetune/train.py"]
CMD ["--help"]
