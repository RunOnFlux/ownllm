          "type": "string"
         }
        },
        "required": [
         "repotag",
         "containerData",
         "cpu",
         "ram",
         "hdd"
        ]
       }
      },
      "contacts": {
       "default": [],
       "type": "array",
       "items": {
        "type": "string"
       }
      }
     },
     "required": [
      "compose"
     ]
    },
    "confirm": {
     "default": false,
     "description": "Set true to actually sign, broadcast and pay.",
