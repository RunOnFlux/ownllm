node_modules/

# Deploy keys (FLUXID_PRIVATEKEY, FLUX_PRIVATEKEY). Never committed - this
# repository is public.
.env

# These carry the real API key in cleartext - they are the input to the
# encrypter, never something that should reach a public repository.
specs/*.plaintext.json

# Envelopes are safe once encrypted (the blob is ciphertext), but a
# freshly generated one still holds the key until encrypt-enterprise.js runs.
# Uncomment if you would rather not commit specs at all.
# specs/*.json

# Holds API_KEY in cleartext for Flux Home import - the UI encrypts it on submit.
specs/*.ui.json

# The corpus is NOT committed. tools/build-corpus.sh reads private repositories
# (fluxai-enterprise, brimley, console-api, ssp-enterprise, ssp-enterprise-app,
# fluxai-beaver, fluxai-fluxedge) and this repository is public. Committing the
# corpus would republish their contents, and baking it into a public GHCR image
# would do the same. See README, "Private sources".
# images/docsbot/docs/corpus.jsonl

# Checkpoint of tools/embed-corpus.js; the finished .vec is what ships.
images/docsbot/docs/*.vec.progress
