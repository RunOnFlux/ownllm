{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "flux": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Flux Cloud LLM",
      "options": {
        "baseURL": "https://<your-app>.app.runonflux.io/api",
        "apiKey": "{env:FLUX_LLM_KEY}"
      },
      "models": {
        "gpt-oss:20b": { "name": "gpt-oss 20b (Flux)", "tools": true },
        "qwen3-coder:30b": { "name": "Qwen3 Coder 30B-A3B (Flux)", "tools": true },
        "qwen3:4b": { "name": "Qwen3 4B (Flux, fast)", "tools": true }
      }
    }
  }
}
